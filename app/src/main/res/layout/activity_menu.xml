<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginTop="50dp"
      tools:ignore="MissingConstraints">

    <ImageView
        android:id="@+id/iconSantri"
        android:layout_width="150dp"
        android:layout_height="170dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/santri" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Santri"
        android:layout_marginStart="20dp"
        android:textSize="18dp" />

    <ImageView
        android:id="@+id/iconGuru"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/guru" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Guru"
        android:layout_marginStart="20dp"
        android:textSize="18dp" />
    <ImageView
        android:id="@+id/iconPelajaran"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/pelajaran" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Pelajaran"
        android:layout_marginStart="20dp"
        android:textSize="18dp" />

    <ImageView
        android:id="@+id/iconSemester"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="20dp"
        android:src="@drawable/semester" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Semester"
        android:layout_marginStart="20dp"
        android:textSize="18dp" />
  </LinearLayout>

  <LinearLayout
      android:layout_marginTop="50dp"
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      tools:ignore="MissingConstraints">

    <ImageView
        android:id="@+id/iconOrtu"
        android:layout_width="150dp"
        android:layout_height="170dp"
        android:layout_marginStart="240dp"
        android:src="@drawable/ortu" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Ortu"
        android:layout_marginStart="240dp"
        android:textSize="18dp" />

    <ImageView
        android:id="@+id/iconKelas"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="240dp"
        android:src="@drawable/kelas" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Kelas"
        android:layout_marginStart="240dp"
        android:textSize="18dp" />
    <ImageView
        android:id="@+id/iconTahunAjaran"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="240dp"
        android:src="@drawable/tahun" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tahun Ajaran"
        android:layout_marginStart="240dp"
        android:textSize="18dp" />

    <ImageView
        android:id="@+id/iconSetting"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="240dp"
        android:src="@drawable/setting" />

    <TextView
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Setting"
        android:layout_marginStart="240dp"
        android:textSize="18dp" />
  </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>